[Unit]
Description=clowder agent
Documentation=https://github.com/webcodingcat/clowder
Wants=network-online.target docker.service
# After network-online.target: by then cloud-init's network stage has read
# the metadata service, which the agent's rules close to the host.
After=network-online.target docker.service
# Restart without limit and never give up: the agent is the host's only way
# to the cluster.
StartLimitIntervalSec=0

[Service]
Type=notify
# The package installs the unit without enabling it; clowderd init (and
# later join) enables and starts it.
ExecStart=/usr/bin/clowderd run
# The agent reports to systemd every few seconds; a hung agent is restarted.
WatchdogSec=15
Restart=always
RestartSec=2
# Except for an agent that stopped at a Raft entry it cannot read (exit
# status 3, a version older than the leader's): it would stop at the same
# entry again. It stays down until an upgrade starts it, and the other hosts
# see it fail. Nothing reboots the host. Nor an agent on a server that
# clowderd recover retired (exit status 4): it must never start again.
RestartPreventExitStatus=3 4
# A worker that clowderd recover kept ends its agent to start again as a
# fresh Raft member (exit status 5). That is no failure, and Restart=always
# starts it again.
SuccessExitStatus=5
# Only the agent itself is stopped. Its helpers (docker compose, drbdadm, a
# volume copy) finish their step instead of being killed halfway; one that
# hangs in state D could not be killed anyway. Containers belong to dockerd
# and are not affected either way.
KillMode=process

[Install]
WantedBy=multi-user.target
