#!/usr/bin/env bash
# Development commands. Everything runs in pinned Docker images, so the host
# needs only Bash and Docker (Linux, macOS; Git Bash or WSL on Windows).
# Usage: bin/dev <command>
#   lint      golangci-lint (with gofumpt, goimports, the import rule), shellcheck,
#             shfmt, yamllint, tofu fmt, tofu validate
#   format    apply what the formatters can fix
#   test      the unit tests (no VMs); arguments go to go test, e.g.
#             bin/dev test ./internal/compose -update (rewrite golden files)
#   test-tools  the golden files of the renderers against the real tools
#             (nft -c, wg, drbdadm, docker-compose) in Debian
#   build     clowderd for linux/amd64, clowder for linux, darwin and windows
#             into dist/
#   package   build, then the Debian packages of clowder and clowderd into dist/
#   all       lint, test, test-tools, package (what CI runs)
#   live      the live tests in HLab labs of their own, up to three at once
#             (LIVE_LABS=<n>, else as many as the free memory holds), each
#             with a group of the scenarios of test/live/scenarios: live up,
#             live run, and live down once they pass (needs
#             HLAB=<path to HLab's bin/hlab> and /dev/kvm). A failed lab keeps
#             its hosts for a look.
#   live up [--lab <n>] [<tag>]  package, make the hosts' image unless it is
#             current (live image), start lab n (default 1) unless it runs,
#             make the first host with examples/hetzner from the image,
#             bootstrap its cluster and have two more hosts join (test/live:
#             TestSetup).
#             With a tag, on a checkout of it, the release without the test
#             hook: the image is made anew from the release, the host
#             installs clowderd from the APT repository, the CLI comes from
#             the GitHub release
#   live run [--lab <n>] [<go test flags>]  the scenarios of test/live on the
#             hosts of lab n (default 1), e.g. bin/dev live run -run TestIngress
#   live down [--lab <n>]  destroy what the live tests left and stop their
#             labs, or lab n
#   live image [--rebuild]  make the hosts' image in a lab of its own unless
#             its inputs are unchanged and it is younger than a week
#             (test/live: TestImage); it stays in the Docker volume
#             clowder-live-image
#   live release <tag>  live up <tag>, live run, live down
set -euo pipefail
# Docker gets Windows paths from pwd -W; Git Bash must not rewrite them. Native
# tools that take a path (git) are called after a cd instead.
export MSYS_NO_PATHCONV=1

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly ROOT
# The repository as Docker sees it (a Windows path under Git Bash).
DOCKER_ROOT="$(cd "${ROOT}" && (pwd -W 2>/dev/null || pwd) )"
readonly DOCKER_ROOT

readonly GO_IMAGE=golang:1.27.3
readonly LINT_IMAGE=golangci/golangci-lint:v2.15.0
readonly NFPM_IMAGE=goreleaser/nfpm:v2.48.0
readonly SHELLCHECK_IMAGE=koalaman/shellcheck:v0.11.0
readonly SHFMT_IMAGE=mvdan/shfmt:v3.14.1
# The yamllint image has only a major tag; the digest pins yamllint 1.32.0.
readonly YAMLLINT_IMAGE=cytopia/yamllint:1@sha256:596fb19eb71e55ba5b2fa56d8c18a615ec82adc8d3bf2d73918cb78c8f3240fb
readonly TOFU_IMAGE=ghcr.io/opentofu/opentofu:1.13.2
# The hosts run Debian 13: its nft, drbdadm and docker-compose check the
# renderers' output.
readonly DEBIAN_IMAGE=debian:trixie-slim
# Go's module and build cache survive between runs.
readonly CACHE_VOLUME=clowder-gocache
readonly BUSYBOX_IMAGE=busybox:1.37.0
# The live tests' labs, clowder-live-1 to clowder-live-<MAX_LABS>
# (test/live/<lab>.yaml), and the lab that makes their hosts' image. Each
# keeps its files in a Docker volume of its name, so bin/dev live run and
# down find them: the OpenTofu state, the SSH key, the CLI, the cluster
# directory, and the lock that keeps two runs apart (live_lock). The image's
# volume also holds the image (host.qcow2) and the hash of its inputs.
readonly MAX_LABS=3
# What a lab takes of the Docker host's memory: at most five servers of 4 GB
# at once (three hosts and those that TestReplace and TestRecover add) and
# the lab itself.
readonly LAB_MEMORY_GB=22
readonly IMAGE_LAB=clowder-live-image
readonly IMAGE_VOLUME="${IMAGE_LAB}"
# An image older than this is made anew: the mirrors' kernel and DRBD move on.
readonly IMAGE_MAX_AGE_DAYS=7
# Debian's image that HLab starts debian-13 from, and the checksums that say
# when it changed.
readonly DEBIAN_SUMS_URL=https://cloud.debian.org/images/cloud/trixie/latest/SHA512SUMS
readonly DEBIAN_IMAGE_FILE=debian-13-generic-amd64.qcow2
readonly REGISTRY_IMAGE=registry:3.0.0
readonly MAILPIT_IMAGE=axllent/mailpit:v1.27.4
# HLab gives tools in the lab's network this address, and the hosts reach it.
readonly LAB_ADDRESS=192.0.2.2
readonly PACKAGE_PORT=8099
readonly PACKAGE_URL="http://${LAB_ADDRESS}:${PACKAGE_PORT}/clowderd.deb"
readonly REGISTRY_PORT=5000
readonly SMTP_PORT=1025
readonly MAIL_API_PORT=8025
# Where the releases' CLI archives are (bin/dev live release).
readonly RELEASES_URL=https://github.com/webcodingcat/clowder/releases/download

# The lab that the live commands work on (use_lab), and its number for the
# live tests' labs (use_test_lab).
lab_config=""
work_volume=""
lab_number=""
# its containers: the clowderd package for the hosts, the private registry
# the test stack pulls from (test/live: registry), and the mail server of the
# alerts' email channel (test/live: mailServer)
packages_container=""
registry_container=""
mail_container=""
# The volume whose lock bin/dev holds (live_lock).
locked_volume=""

# in_image <image> <command...>: Run a command in an image with the repository
# mounted at /src as the working directory.
in_image() {
  local image="$1"
  shift
  docker run --rm -v "${DOCKER_ROOT}:/src" -w /src -v "${CACHE_VOLUME}:/go" \
    -e GOFLAGS=-buildvcs=false "${image}" "$@"
}

# release_tag: Print the tag the build is for: the one the release workflow
# runs on (a final tag may share its commit with the release candidate),
# else the checked-out commit's; fail without one.
# Globals:
#   GITHUB_REF_TYPE, GITHUB_REF_NAME (read; set by GitHub Actions)
release_tag() {
  if [[ "${GITHUB_REF_TYPE:-}" == tag ]]; then
    echo "${GITHUB_REF_NAME}"
    return
  fi
  (cd "${ROOT}" && git describe --tags --exact-match 2>/dev/null)
}

# package_version <tag>: Print the Debian version of a tag, without the
# leading v (v1.2.3 -> 1.2.3, v1.2.3-rc1 -> 1.2.3~rc1, which sorts before
# 1.2.3 in Debian's version order).
package_version() {
  local tag="${1#v}"
  echo "${tag//-/\~}"
}

# version: Print the version for the build: the tag's package version, or
# 0.0.0~dev+<commit> without a tag, which sorts before any release.
version() {
  local tag commit
  if tag="$(release_tag)"; then
    package_version "${tag}"
    return
  fi
  commit="$(cd "${ROOT}" && git rev-parse --short HEAD 2>/dev/null || echo unknown)"
  echo "0.0.0~dev+${commit}"
}

# shell_files: Print the shell scripts of the repository.
shell_files() {
  (cd "${ROOT}" && git ls-files --cached --others --exclude-standard bin/dev '*.sh')
}

# cmd_lint: Run every style check; any finding fails.
cmd_lint() {
  local scripts
  in_image "${LINT_IMAGE}" golangci-lint run ./...
  mapfile -t scripts < <(shell_files)
  in_image "${SHELLCHECK_IMAGE}" "${scripts[@]}"
  in_image "${SHFMT_IMAGE}" -i 2 -ci -bn -d "${scripts[@]}"
  in_image "${YAMLLINT_IMAGE}" .
  in_image "${TOFU_IMAGE}" fmt -check -recursive .
  tofu_validate examples/hetzner
}

# tofu_validate <module>: Check an OpenTofu module against its providers,
# with the committed lock file only; the providers are cached in Go's cache
# volume, and OpenTofu's data stays out of the repository.
tofu_validate() {
  docker run --rm -v "${DOCKER_ROOT}:/src" -w "/src/$1" -v "${CACHE_VOLUME}:/go" \
    -e TF_PLUGIN_CACHE_DIR=/go/tofu-plugins -e TF_DATA_DIR=/tmp/tofu --entrypoint sh "${TOFU_IMAGE}" \
    -c 'mkdir -p "${TF_PLUGIN_CACHE_DIR}" && tofu init -backend=false -input=false -lockfile=readonly >/dev/null && tofu validate -no-color'
}

# cmd_format: Rewrite Go and shell files as the formatters want them.
cmd_format() {
  local scripts
  in_image "${LINT_IMAGE}" golangci-lint fmt ./...
  mapfile -t scripts < <(shell_files)
  in_image "${SHFMT_IMAGE}" -i 2 -ci -bn -w "${scripts[@]}"
}

# cmd_test: Run the unit tests; arguments go to go test, e.g.
# bin/dev test ./internal/compose -update
cmd_test() {
  if (($# == 0)); then
    set -- ./...
  fi
  local status=0
  # with the race detector: the agent's loops share the runner and the state
  in_image "${GO_IMAGE}" go test -race "$@" || status=$?
  if [[ " $* " == *" -update "* ]]; then
    give_back internal
  fi
  return "${status}"
}

# cmd_test_tools: Check the renderers' golden files with Debian's nft, wg,
# drbdadm and docker-compose (the hostname node0 is a host of the resource
# files).
cmd_test_tools() {
  docker run --rm --cap-add NET_ADMIN --hostname node0 -v "${DOCKER_ROOT}:/src" -w /src \
    "${DEBIAN_IMAGE}" sh test/tools/check-golden-files.sh
}

# cmd_build: Build clowderd for Linux and clowder for each platform into dist/.
cmd_build() {
  local ldflags target goos goarch
  ldflags="-s -w -X github.com/webcodingcat/clowder/internal/buildinfo.Version=$(version)"
  rm -rf "${ROOT}/dist"
  in_image "${GO_IMAGE}" env CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -trimpath -ldflags "${ldflags}" -o dist/linux-amd64/clowderd ./cmd/clowderd
  for target in linux/amd64 darwin/amd64 darwin/arm64 windows/amd64; do
    goos="${target%/*}"
    goarch="${target#*/}"
    in_image "${GO_IMAGE}" env CGO_ENABLED=0 GOOS="${goos}" GOARCH="${goarch}" \
      go build -trimpath -ldflags "${ldflags}" \
      -o "dist/${goos}-${goarch}/clowder$([[ "${goos}" == windows ]] && echo .exe)" \
      ./cmd/clowder
  done
  give_back dist
}

# give_back <path>: The containers run as root, so on Linux (CI as well) what
# they write belongs to root; hand it to the caller (dist/ after a build, the
# golden files after test -update).
give_back() {
  in_image "${GO_IMAGE}" chown -R "$(id -u):$(id -g)" "$1"
}

# cmd_package: Build, then make the Debian packages of both binaries.
cmd_package() {
  local package package_version
  cmd_build
  package_version="$(version)"
  for package in clowder clowderd; do
    # the image's entrypoint is nfpm itself
    docker run --rm -v "${DOCKER_ROOT}:/src" -w /src -e VERSION="${package_version}" \
      "${NFPM_IMAGE}" package --config "packaging/${package}.yaml" --packager deb \
      --target dist/
  done
  give_back dist
  ls -1 "${ROOT}/dist"/*.deb
}

# use_lab <name>: Point the live commands at a lab: its HLab configuration
# in test/live, the Docker volume of its files and its containers, each
# named after it.
# Globals:
#   lab_config, work_volume, packages_container, registry_container,
#   mail_container (set)
use_lab() {
  lab_config="${ROOT}/test/live/$1.yaml"
  work_volume="$1"
  packages_container="$1-packages"
  registry_container="$1-registry"
  mail_container="$1-mail"
}

# use_test_lab <n>: use_lab for the live tests' lab n.
# Globals:
#   lab_number (set)
use_test_lab() {
  lab_number="$1"
  use_lab "clowder-live-$1"
}

# lab <arguments>: HLab's wrapper with the lab of use_lab.
# Globals:
#   HLAB, lab_config (read)
lab() {
  "${HLAB:?set HLAB to the path of bin/hlab in HLab}" -c "${lab_config}" "$@"
}

# in_lab <image> <command...>: Run a command in the lab's network with the
# repository at /src as the working directory, Go's caches at /go and the
# lab's files at /work.
# Globals:
#   HLAB_NETWORK, HCLOUD_ENDPOINT, HCLOUD_TOKEN, work_volume (read)
in_lab() {
  local image="$1"
  shift
  docker run --rm -i --network "${HLAB_NETWORK}" -v "${DOCKER_ROOT}:/src" -w /src \
    -v "${CACHE_VOLUME}:/go" -v "${work_volume}:/work" -e HCLOUD_ENDPOINT -e HCLOUD_TOKEN \
    -e HLAB_CONTROL -e HLAB_ACME_DIRECTORY -e HLAB_ACME_CA -e GOFLAGS=-buildvcs=false "${image}" "$@"
}

# live_lock: Take the lock of the lab's volume, held until bin/dev ends or
# live_unlock, or fail if another bin/dev holds it: two runs would share the
# lab and the volume. flock in a container holds it while the container's
# stdin is open; that is a pipe from this shell, which closes however
# bin/dev ends. The lock file is a dot file, which rm -rf /work/* keeps.
# Bash runs one coproc at a time, so bin/dev holds one lock at a time.
# Globals:
#   work_volume (read)
#   LIVE_LOCK, LIVE_LOCK_PID (set by coproc), locked_volume (set)
live_lock() {
  local answer=""
  if [[ "${locked_volume}" == "${work_volume}" ]]; then
    return 0
  fi
  if [[ -n "${locked_volume}" ]]; then
    live_unlock
  fi
  coproc LIVE_LOCK {
    docker run --rm -i -v "${work_volume}:/work" "${BUSYBOX_IMAGE}" \
      flock -n /work/.lock sh -c 'echo locked && exec cat >/dev/null'
  }
  read -r answer <&"${LIVE_LOCK[0]}" || true
  if [[ "${answer}" != locked ]]; then
    echo "bin/dev live: another run holds ${work_volume}, or its lock failed" >&2
    exit 1
  fi
  locked_volume="${work_volume}"
}

# live_unlock: Give the lock of live_lock back: the container's stdin closes.
# Globals:
#   LIVE_LOCK, LIVE_LOCK_PID (read)
#   locked_volume (set)
live_unlock() {
  local pid="${LIVE_LOCK_PID}" to_lock="${LIVE_LOCK[1]}" from_lock="${LIVE_LOCK[0]}"
  exec {to_lock}>&- {from_lock}<&-
  wait "${pid}" || true
  locked_volume=""
}

# lab_runs: Tell whether the lab runs: hlab status asks the lab's control
# and fails without a running lab.
lab_runs() {
  lab status >/dev/null 2>&1
}

# live_lab: Start the lab unless it runs (hlab up would start a running lab
# afresh and shut its servers down), and set its variables.
live_lab() {
  if ! lab_runs; then
    lab up
  fi
  eval "$(lab env)"
}

# live_tofu <command>: A shell command with OpenTofu on examples/hetzner in
# the lab's network; the state and OpenTofu's data stay in /work.
# Globals:
#   HLAB_NETWORK, HCLOUD_ENDPOINT, HCLOUD_TOKEN, work_volume (read)
live_tofu() {
  docker run --rm --network "${HLAB_NETWORK}" -v "${DOCKER_ROOT}:/src" -w /src/examples/hetzner \
    -v "${CACHE_VOLUME}:/go" -v "${work_volume}:/work" -e HCLOUD_ENDPOINT -e HCLOUD_TOKEN \
    -e TF_DATA_DIR=/work/tofu -e TF_PLUGIN_CACHE_DIR=/go/tofu-plugins -e TF_IN_AUTOMATION=1 \
    --entrypoint sh "${TOFU_IMAGE}" -c "mkdir -p \"\${TF_PLUGIN_CACHE_DIR}\" \
      && tofu init -input=false -lockfile=readonly >/dev/null && $1"
}

# live_host_left: Tell whether an earlier run left OpenTofu state, that is a
# host. A failure to look is an error, not a "no": the state is the only way
# to destroy the host.
# Globals:
#   work_volume (read)
live_host_left() {
  local answer
  # outside the lab's network: bin/dev live up asks before the lab runs
  answer="$(docker run --rm -v "${work_volume}:/work" "${BUSYBOX_IMAGE}" \
    sh -c 'if test -e /work/terraform.tfstate; then echo yes; else echo no; fi')"
  case "${answer}" in
    yes) return 0 ;;
    no) return 1 ;;
    *)
      echo "bin/dev live: cannot tell whether a host is left" >&2
      exit 1
      ;;
  esac
}

# start_registry: A private registry in the lab's network, with TLS from a
# throw-away CA and a password, as test/live expects them in
# /work/registry (ca.crt, password; the user is tester).
# Globals:
#   HLAB_NETWORK, work_volume, registry_container (read)
start_registry() {
  # Debian's openssl and htpasswd (bcrypt, which the registry wants), in the
  # Debian image the tools already use, rather than one more image; outside
  # the lab's network, where apt reaches Debian's mirror
  docker run --rm -v "${work_volume}:/work" -e "ADDRESS=${LAB_ADDRESS}" "${DEBIAN_IMAGE}" sh -c '
    set -e
    apt-get -qq update && apt-get -qq install -y --no-install-recommends openssl apache2-utils >/dev/null
    mkdir /work/registry && cd /work/registry
    openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:P-256 -nodes -days 2 \
      -subj /CN=clowder-live-ca -keyout ca.key -out ca.crt 2>/dev/null
    openssl req -newkey ec -pkeyopt ec_paramgen_curve:P-256 -nodes -subj "/CN=${ADDRESS}" \
      -keyout server.key -out server.csr 2>/dev/null
    printf "subjectAltName=IP:%s\n" "${ADDRESS}" >server.ext
    openssl x509 -req -in server.csr -CA ca.crt -CAkey ca.key -CAcreateserial -days 2 \
      -extfile server.ext -out server.crt 2>/dev/null
    openssl rand -hex 16 >password
    htpasswd -Bbn tester "$(cat password)" >htpasswd'
  docker rm -f "${registry_container}" >/dev/null 2>&1 || true
  docker run -d --rm --name "${registry_container}" --network "${HLAB_NETWORK}" \
    -v "${work_volume}:/work:ro" -e "REGISTRY_HTTP_ADDR=${LAB_ADDRESS}:${REGISTRY_PORT}" \
    -e REGISTRY_HTTP_TLS_CERTIFICATE=/work/registry/server.crt \
    -e REGISTRY_HTTP_TLS_KEY=/work/registry/server.key \
    -e REGISTRY_AUTH=htpasswd -e REGISTRY_AUTH_HTPASSWD_REALM=clowder-live \
    -e REGISTRY_AUTH_HTPASSWD_PATH=/work/registry/htpasswd "${REGISTRY_IMAGE}" >/dev/null
}

# start_mail: The mail server of the alerts' email channel in the lab's
# network: STARTTLS required, with the registry's certificate (its CA is in
# /work/registry/ca.crt), any login; its API lets the test read the mail.
# Globals:
#   HLAB_NETWORK, work_volume, mail_container (read)
start_mail() {
  docker rm -f "${mail_container}" >/dev/null 2>&1 || true
  docker run -d --rm --name "${mail_container}" --network "${HLAB_NETWORK}" -v "${work_volume}:/work:ro" \
    "${MAILPIT_IMAGE}" --smtp "${LAB_ADDRESS}:${SMTP_PORT}" --listen "${LAB_ADDRESS}:${MAIL_API_PORT}" \
    --smtp-tls-cert /work/registry/server.crt --smtp-tls-key /work/registry/server.key \
    --smtp-require-starttls --smtp-auth-accept-any >/dev/null
}

# serve_package: Serve the clowderd package of dist/ in the lab's network at
# PACKAGE_URL; print its SHA-256.
# Globals:
#   HLAB_NETWORK, work_volume, packages_container (read)
serve_package() {
  local sha256
  sha256="$(in_lab "${GO_IMAGE}" sh -c 'mkdir /work/www && cp dist/clowderd_*_amd64.deb /work/www/clowderd.deb \
    && sha256sum /work/www/clowderd.deb' </dev/null | cut -d ' ' -f 1)"
  docker rm -f "${packages_container}" >/dev/null 2>&1 || true
  docker run -d --rm --name "${packages_container}" --network "${HLAB_NETWORK}" \
    -v "${work_volume}:/work:ro" "${BUSYBOX_IMAGE}" \
    httpd -f -p "${LAB_ADDRESS}:${PACKAGE_PORT}" -h /work/www >/dev/null
  echo "${sha256}"
}

# fetch_release_cli <tag>: Download the release's CLI for Linux into
# /work/cli.
# Globals:
#   work_volume (read)
fetch_release_cli() {
  local tag="$1"
  # outside the lab's network, where GitHub is reachable
  docker run --rm -v "${work_volume}:/work" "${GO_IMAGE}" sh -c \
    'mkdir /work/cli && curl -fsSL "$1" | tar -xz -C /work/cli clowder' \
    sh "${RELEASES_URL}/${tag}/clowder_${tag}_linux-amd64.tar.gz"
}

# at_release_checkout <tag>: Fail unless the checkout is the tag's commit,
# without changes: the tests of a release come from the checkout.
at_release_checkout() {
  local tag="$1"
  if [[ "$(cd "${ROOT}" && git rev-parse "${tag}^{commit}" 2>/dev/null)" != "$(cd "${ROOT}" && git rev-parse HEAD)" ]]; then
    echo "bin/dev live: the hosts run the release ${tag}; check out its tag first" >&2
    return 1
  fi
  if [[ -n "$(cd "${ROOT}" && git status --porcelain)" ]]; then
    echo "bin/dev live: the tests come from the checkout; commit or stash its changes first" >&2
    return 1
  fi
}

# image_inputs: Print the hash of what the hosts' image is made of: Debian's
# image, the setup and its unit, clowderd's dependencies (its package's
# configuration) and how TestImage prepares and cleans the server.
image_inputs() {
  # $1 and $2 are the shell's in the container
  # shellcheck disable=SC2016
  in_image "${GO_IMAGE}" sh -c 'set -e
    { curl -fsSL "$1" | grep " $2\$"
      sha256sum examples/hetzner/setup.sh examples/hetzner/clowder-setup.service \
        packaging/clowderd.yaml test/live/image_test.go
    } | sha256sum | cut -c 1-16' sh "${DEBIAN_SUMS_URL}" "${DEBIAN_IMAGE_FILE}"
}

# image_current <inputs>: Tell whether the image's volume holds an image of
# these inputs, younger than IMAGE_MAX_AGE_DAYS.
image_current() {
  docker run --rm -v "${IMAGE_VOLUME}:/image:ro" "${BUSYBOX_IMAGE}" sh -c \
    'test -s /image/host.qcow2 && test "$(cat /image/inputs 2>/dev/null)" = "$1" \
      && test -n "$(find /image/host.qcow2 -mtime -"$2")"' sh "$1" "${IMAGE_MAX_AGE_DAYS}"
}

# ensure_image [--rebuild] [<tag>]: Make the hosts' image unless the
# image's volume holds a current one (image_current) or --rebuild says to.
# For a release (with its tag) always anew, from the release's packages: the
# release's setup runs from scratch once per run. Its inputs name the
# release, so the next run of a checkout makes its own image again.
# make_image runs in a subshell: it points the live commands at the image's
# lab, which the caller's lab must not become, and its lock ends with it.
ensure_image() {
  local rebuild="" tag inputs
  if [[ "${1:-}" == --rebuild ]]; then
    rebuild=yes
    shift
  fi
  tag="${1:-}"
  if [[ -n "${tag}" ]]; then
    (make_image "release-${tag}" "${tag}")
    return
  fi
  inputs="$(image_inputs)"
  if [[ -z "${rebuild}" ]] && image_current "${inputs}"; then
    echo "bin/dev live: the hosts' image is current (${inputs})"
    return
  fi
  (make_image "${inputs}" "")
}

# make_image <inputs> <tag>: Make the hosts' image in a lab of its own:
# TestImage prepares a server with setup.sh and snapshots it; the snapshot
# goes into the image's volume as host.qcow2, with its inputs. Without a
# tag, the setup reads clowderd's dependencies from the package of dist/
# (cmd_package made it); with one, from the release in the APT repository.
# The lab stops once the image is in the volume and keeps its own volume,
# with Debian's image loaded; a failure leaves it running for a look.
make_image() {
  local inputs="$1" tag="$2" settings image_id
  use_lab "${IMAGE_LAB}"
  live_lock
  live_lab
  # a failed image leaves its server; the snapshots of the image before go too
  lab reset
  in_lab "${GO_IMAGE}" sh -c 'rm -rf /work/www /work/id_ed25519* /work/known_hosts /work/image.env \
    /work/image-id && ssh-keygen -q -t ed25519 -N "" -C clowder-live -f /work/id_ed25519' </dev/null
  if [[ -n "${tag}" ]]; then
    settings="CLOWDERD_VERSION='$(package_version "${tag}")'"$'\n'"PACKAGE_URL=''"$'\n'"PACKAGE_SHA256=''"
  else
    settings="CLOWDERD_VERSION=''"$'\n'"PACKAGE_URL='${PACKAGE_URL}'"$'\n'"PACKAGE_SHA256='$(serve_package)'"
  fi
  printf '%s\n' "${settings}" | in_lab "${GO_IMAGE}" sh -c 'cat >/work/image.env'
  if ! IMAGE_LABEL="${inputs}" live_go_test -run '^TestImage$'; then
    echo "bin/dev live: the image failed; its lab ${IMAGE_LAB} stays for a look" \
      "(ssh from the lab's network with /work/id_ed25519 in the volume ${IMAGE_VOLUME});" \
      "the next bin/dev live image makes it anew" >&2
    return 1
  fi
  image_id="$(in_lab "${GO_IMAGE}" cat /work/image-id </dev/null)"
  # the inputs only beside a whole image: image_current reads them. The
  # export names the file only once it is whole, and copies inside Docker.
  docker run --rm -v "${IMAGE_VOLUME}:/image" "${BUSYBOX_IMAGE}" rm -f /image/inputs
  lab image export "${image_id}" --volume "${IMAGE_VOLUME}:host.qcow2"
  docker run --rm -v "${IMAGE_VOLUME}:/image" "${BUSYBOX_IMAGE}" sh -c \
    'echo "$1" >/image/inputs' sh "${inputs}"
  docker rm -f "${packages_container}" >/dev/null 2>&1 || true
  lab down
  echo "bin/dev live: made the hosts' image (${inputs})"
}

# prepare_live [<tag>]: What every lab's up needs first: the packages (or,
# with a tag, a checkout at it) and the hosts' image.
prepare_live() {
  local tag="${1:-}"
  if [[ -n "${tag}" ]]; then
    at_release_checkout "${tag}"
  else
    cmd_package
  fi
  ensure_image "${tag}"
  # the labs run tofu init at once; with the providers in the cache before,
  # none of them writes to it
  tofu_validate examples/hetzner
}

# import_image: Import the hosts' image from its volume into the lab as a
# snapshot labeled with its inputs; print its ID. The copy stays inside
# Docker.
import_image() {
  local inputs
  inputs="$(docker run --rm -v "${IMAGE_VOLUME}:/image:ro" "${BUSYBOX_IMAGE}" cat /image/inputs)"
  lab image import --volume "${IMAGE_VOLUME}:host.qcow2" --description "clowder live host" \
    --label "clowder-live-image=${inputs}"
}

# up_lab [<tag>]: Make the first host in the lab of use_test_lab, started
# unless it runs, from the hosts' image (prepare_live made it); TestSetup
# bootstraps its cluster and has two more hosts join, with OpenTofu copied
# to /work/bin. The registry and the mail server run on until bin/dev live
# down. With a tag, on that release instead of dist/.
# Globals:
#   lab_number (read)
up_lab() {
  local tag="${1:-}" package_variables public_key image_id
  live_lock
  refuse_left_host
  live_lab
  in_lab "${GO_IMAGE}" sh -c 'rm -rf /work/* \
    && ssh-keygen -q -t ed25519 -N "" -C clowder-live -f /work/id_ed25519' </dev/null
  # live run checks again that the checkout is at this tag
  printf '%s' "${tag}" | in_lab "${GO_IMAGE}" sh -c 'cat >/work/release-tag'
  if [[ -n "${tag}" ]]; then
    fetch_release_cli "${tag}"
    package_variables="clowderd_version = \"$(package_version "${tag}")\""
  else
    package_variables="clowderd_package_url    = \"${PACKAGE_URL}\""$'\n'"clowderd_package_sha256 = \"$(serve_package)\""
    in_lab "${GO_IMAGE}" sh -c 'mkdir /work/cli && cp dist/linux-amd64/clowder /work/cli/' </dev/null
  fi
  image_id="$(import_image)"
  public_key="$(in_lab "${GO_IMAGE}" cat /work/id_ed25519.pub </dev/null)"
  # bulk holds the 20 GB volume of TestNoFalseFailover (resyncVolumeSize): its
  # pool is 90 % of the disk, and the placement keeps 20 % of that free
  in_lab "${GO_IMAGE}" sh -c 'cat >/work/live.tfvars' <<EOF
ssh_public_key  = "${public_key}"
admin_cidrs     = ["${LAB_ADDRESS}/32"]
storage_classes = { fast = 20, bulk = 30, small = 10 }
published_ports = ["udp/9987"]
image           = "${image_id}"
${package_variables}
EOF
  start_registry
  start_mail
  # the tests run OpenTofu themselves for the hosts that join (test/live: tofu)
  if ! live_tofu 'tofu apply -input=false -auto-approve -state=/work/terraform.tfstate \
    -var-file=/work/live.tfvars && tofu output -json -state=/work/terraform.tfstate >/work/outputs.json \
    && mkdir -p /work/bin && cp /usr/local/bin/tofu /work/bin/tofu' \
    || ! live_go_test -run '^TestSetup$'; then
    live_failed "bin/dev live down --lab ${lab_number}, then up, makes it anew"
  fi
}

# run_lab [<go test flags>]: Run the scenarios on the hosts of the lab of
# use_test_lab; they stay, whatever the outcome.
# Globals:
#   lab_number, registry_container, mail_container (read)
run_lab() {
  local tag
  live_lock
  # not live_lab: a lab started now would have no host
  if ! lab_runs; then
    echo "bin/dev live run: lab ${lab_number} is not up; bin/dev live up --lab ${lab_number} starts it" >&2
    return 1
  fi
  eval "$(lab env)"
  if ! live_host_left; then
    echo "bin/dev live run: lab ${lab_number} has no host; bin/dev live up --lab ${lab_number} makes one" >&2
    return 1
  fi
  # a new registry would not have the image that TestSetup pushed
  if ! container_runs "${registry_container}" || ! container_runs "${mail_container}"; then
    echo "bin/dev live run: the registry or the mail server of lab ${lab_number} stopped;" \
      "bin/dev live down --lab ${lab_number}, then up" >&2
    return 1
  fi
  # after live up <tag> the hosts run that release, and the tests must match
  tag="$(in_lab "${GO_IMAGE}" sh -c 'cat /work/release-tag 2>/dev/null || true' </dev/null)"
  if [[ -n "${tag}" ]]; then
    at_release_checkout "${tag}"
  fi
  live_go_test -skip '^Test(Setup|Image)$' "$@" \
    || live_failed "bin/dev live run --lab ${lab_number} -run <test> runs a scenario again," \
      "bin/dev live down --lab ${lab_number} removes it all"
}

# down_lab: Destroy what the live tests left in the lab of use_lab and stop
# it. A lab that never ran has no volume and is left alone.
# Globals:
#   work_volume, packages_container, registry_container, mail_container (read)
down_lab() {
  if ! docker volume inspect "${work_volume}" >/dev/null 2>&1; then
    return 0
  fi
  live_lock
  docker rm -f "${packages_container}" "${registry_container}" "${mail_container}" >/dev/null 2>&1 || true
  if live_host_left; then
    live_lab
    # hosts.tfvars names the hosts that joined (test/live writes it)
    live_tofu 'touch /work/hosts.tfvars && tofu destroy -input=false -auto-approve \
      -state=/work/terraform.tfstate -var-file=/work/live.tfvars -var-file=/work/hosts.tfvars'
  fi
  # only after a destroy that worked (set -e): the state goes with the rest
  docker run --rm -v "${work_volume}:/work" "${BUSYBOX_IMAGE}" sh -c 'rm -rf /work/*'
  if lab_runs; then
    lab down
  fi
}

# refuse_left_host: Fail if an earlier run left a host in the lab.
# Globals:
#   work_volume, lab_number (read)
refuse_left_host() {
  if live_host_left; then
    echo "bin/dev live up: lab ${lab_number} has a host left (its OpenTofu state is in the volume" \
      "${work_volume}); bin/dev live run --lab ${lab_number} tests it, bin/dev live down" \
      "--lab ${lab_number} removes it" >&2
    exit 1
  fi
}

# container_runs <name>: Tell whether the container runs.
container_runs() {
  [[ "$(docker inspect --format '{{.State.Running}}' "$1" 2>/dev/null)" == true ]]
}

# live_go_test <go test flags>: Run test/live in the lab's network with the
# CLI that bin/dev live up put in /work/cli; the first failure ends it. The
# timeout leaves room for every scenario on one lab.
# Globals:
#   IMAGE_LABEL (read; TestImage's)
live_go_test() {
  in_lab "${GO_IMAGE}" env LIVE_DIR=/work CLOWDER=/work/cli/clowder IMAGE_LABEL="${IMAGE_LABEL:-}" \
    go test -tags live -count=1 -failfast -timeout 150m -v "$@" ./test/live </dev/null
}

# live_failed <next...>: Say that the hosts stay after a failure, and how to
# go on; fail.
# Globals:
#   work_volume (read)
live_failed() {
  echo "bin/dev live: failed; the hosts stay for a look (ssh from the lab's network with" \
    "/work/id_ed25519 in the volume ${work_volume}); $*" >&2
  return 1
}

# lab_count: Print how many labs bin/dev live runs: LIVE_LABS, else as many
# as the Docker host's free memory holds (LAB_MEMORY_GB each), from 1 to
# MAX_LABS.
lab_count() {
  local count available_kb
  if [[ -n "${LIVE_LABS:-}" ]]; then
    if [[ ! "${LIVE_LABS}" =~ ^[1-9]$ ]] || ((LIVE_LABS > MAX_LABS)); then
      echo "bin/dev live: LIVE_LABS is a number from 1 to ${MAX_LABS}" >&2
      exit 2
    fi
    echo "${LIVE_LABS}"
    return
  fi
  # the memory of Docker's host, which is a VM on Windows and macOS
  available_kb="$(docker run --rm "${BUSYBOX_IMAGE}" awk '/^MemAvailable:/ {print $2}' /proc/meminfo)"
  count=$((available_kb / (LAB_MEMORY_GB * 1024 * 1024)))
  echo $((count < 1 ? 1 : count > MAX_LABS ? MAX_LABS : count))
}

# scenario_groups <count>: Print a -run pattern per lab, one per line: the
# scenarios of test/live/scenarios split by their run time, the longest
# first to the lab with the least so far.
scenario_groups() {
  grep -v -e '^#' -e '^[[:space:]]*$' "${ROOT}/test/live/scenarios" | sort -k 2,2 -g -r \
    | awk -v labs="$1" '
      {
        least = 1
        for (lab = 2; lab <= labs; lab++) {
          if (minutes[lab] < minutes[least]) least = lab
        }
        minutes[least] += $2
        names[least] = names[least] (names[least] == "" ? "" : "|") $1
      }
      END {
        for (lab = 1; lab <= labs; lab++) printf "^(%s)$ %s\n", names[lab], minutes[lab]
      }'
}

# cycle_lab <tag> <pattern>: up, run with the -run pattern, and down, in the
# lab of use_test_lab; a failure ends it before down (set -e), and the hosts
# stay.
cycle_lab() {
  up_lab "$1"
  run_lab -run "$2"
  down_lab
}

# cmd_live [<tag>]: Run every scenario in as many labs at once as
# lab_count says, each lab a group of scenario_groups, and tear each lab
# down once it passed. Each lab's lines start with its number; a failed lab
# keeps its hosts.
cmd_live() {
  local tag="${1:-}" count lab pattern minutes failed=()
  local -a patterns=() pids=()
  count="$(lab_count)"
  for ((lab = 1; lab <= count; lab++)); do
    use_test_lab "${lab}"
    # asked again under each lab's lock; this spares the build and the image
    refuse_left_host
  done
  prepare_live "${tag}"
  while read -r pattern minutes; do
    patterns+=("${pattern}")
    echo "bin/dev live: lab ${#patterns[@]} runs ${pattern} (about ${minutes} min)"
  done < <(scenario_groups "${count}")
  # an empty pattern would run every scenario in every lab
  if ((${#patterns[@]} != count)) || [[ " ${patterns[*]} " == *" ^()$ "* ]]; then
    echo "bin/dev live: cannot split test/live/scenarios among ${count} labs" >&2
    return 1
  fi
  for ((lab = 1; lab <= count; lab++)); do
    # sed -u: each lab's lines as they come. set -e ends the subshell at the
    # first failure, and with pipefail wait gets its status, not sed's
    (
      use_test_lab "${lab}"
      cycle_lab "${tag}" "${patterns[lab - 1]}"
    ) 2>&1 | sed -u "s/^/[lab ${lab}] /" &
    pids+=("$!")
  done
  for ((lab = 1; lab <= count; lab++)); do
    if ! wait "${pids[lab - 1]}"; then
      failed+=("${lab}")
    fi
  done
  if ((${#failed[@]} > 0)); then
    echo "bin/dev live: failed in lab ${failed[*]}; its hosts stay (bin/dev live run --lab <n>," \
      "bin/dev live down)" >&2
    return 1
  fi
  echo "bin/dev live: passed in ${count} labs"
}

# cmd_live_up [--lab <n>] [<tag>]: prepare_live, then up_lab in lab n
# (default 1). With a tag, on that release; the tests come from the
# checkout, so it must be at the tag.
cmd_live_up() {
  local lab=1
  if [[ "${1:-}" == --lab ]]; then
    lab="$(checked_lab "${2:-}")"
    shift 2
  fi
  use_test_lab "${lab}"
  # asked again under the lock in up_lab; this spares the build and the image
  refuse_left_host
  prepare_live "${1:-}"
  up_lab "${1:-}"
}

# cmd_live_run [--lab <n>] [<go test flags>]: run_lab in lab n (default 1),
# every scenario unless the flags choose.
cmd_live_run() {
  local lab=1
  if [[ "${1:-}" == --lab ]]; then
    lab="$(checked_lab "${2:-}")"
    shift 2
  fi
  use_test_lab "${lab}"
  run_lab "$@"
}

# cmd_live_down [--lab <n>]: down_lab in lab n, or in every lab, and
# stop the image's lab that a failed image left running.
cmd_live_down() {
  local lab
  if [[ "${1:-}" == --lab ]]; then
    lab="$(checked_lab "${2:-}")"
    use_test_lab "${lab}"
    down_lab
    return
  fi
  use_lab "${IMAGE_LAB}"
  live_lock
  docker rm -f "${packages_container}" >/dev/null 2>&1 || true
  if lab_runs; then
    lab down
  fi
  for ((lab = 1; lab <= MAX_LABS; lab++)); do
    use_test_lab "${lab}"
    down_lab
  done
}

# cmd_live_image [--rebuild]: Make the hosts' image unless a current one is
# there, as bin/dev live up does.
cmd_live_image() {
  if (($# > 1)) || [[ $# == 1 && "$1" != --rebuild ]]; then
    echo "bin/dev live image: takes only --rebuild" >&2
    exit 2
  fi
  cmd_package
  ensure_image "$@"
}

# checked_lab <n>: Print the lab number of --lab; fail unless it names a
# lab.
checked_lab() {
  if [[ ! "$1" =~ ^[1-9]$ ]] || (($1 > MAX_LABS)); then
    echo "bin/dev live: --lab takes a lab from 1 to ${MAX_LABS}" >&2
    exit 2
  fi
  echo "$1"
}

# cmd_all: Everything CI runs.
cmd_all() {
  cmd_lint
  cmd_test
  cmd_test_tools
  cmd_package
}

# main: Dispatch to the command named in the first argument.
main() {
  case "${1:-}" in
    lint | format | build | package | all) "cmd_$1" ;;
    test) cmd_test "${@:2}" ;;
    test-tools) cmd_test_tools ;;
    live)
      case "${2:-}" in
        "") cmd_live ;;
        up) cmd_live_up "${@:3}" ;;
        run) cmd_live_run "${@:3}" ;;
        down) cmd_live_down "${@:3}" ;;
        image) cmd_live_image "${@:3}" ;;
        release) cmd_live "${3:?bin/dev live release needs a tag}" ;;
        *)
          echo "bin/dev live: unknown mode ${2} (up [--lab <n>] [<tag>]," \
            "run [--lab <n>] [<go test flags>], down [--lab <n>], image [--rebuild], release <tag>)" >&2
          exit 2
          ;;
      esac
      ;;
    *)
      sed -n '2,/^set -euo/p' "${BASH_SOURCE[0]}" | sed '$d' | sed 's/^# \{0,1\}//' >&2
      exit 2
      ;;
  esac
}

main "$@"
