#!/usr/bin/env bash
# Development commands. Everything runs in pinned Docker images, so the host
# needs only Bash and Docker (Linux, macOS; Git Bash or WSL on Windows).
# Usage: bin/dev <command>
#   lint      golangci-lint (with gofumpt, goimports, the import rule), shellcheck,
#             shfmt, yamllint, tofu fmt, tofu validate
#   format    apply what the formatters can fix
#   test      the unit tests (no VMs); arguments go to go test, e.g.
#             bin/dev test ./internal/compose -update (rewrite golden files)
#   test-sops the tests of internal/sopsage against the real sops (Alpine's
#             package)
#   test-tools  the golden files of the renderers against the real tools
#             (nft -c, drbdadm, docker-compose) in Debian
#   build     clowderd for linux/amd64, clowder for linux, darwin and windows
#             into dist/
#   package   build, then the Debian packages of clowder and clowderd into dist/
#   all       lint, test, test-sops, test-tools, package (what CI runs)
#   live      package, then the live tests in an HLab lab of their own:
#             examples/hetzner makes a host, test/live drives it (about 20
#             minutes; needs HLAB=<path to HLab's bin/hlab> and /dev/kvm).
#             What a failed run leaves stays for a look.
#   live down destroy what the live tests left and stop their lab
set -euo pipefail
# Docker gets Windows paths from pwd -W; Git Bash must not rewrite them. Native
# tools that take a path (git) are called after a cd instead.
export MSYS_NO_PATHCONV=1

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
readonly ROOT
# The repository as Docker sees it (a Windows path under Git Bash).
DOCKER_ROOT="$(cd "${ROOT}" && (pwd -W 2>/dev/null || pwd) )"
readonly DOCKER_ROOT

readonly GO_IMAGE=golang:1.27.3
# Alpine packages sops, so the cross-tests install it in seconds; this image
# (Alpine 3.24) brings sops 3.12.2, the version of the fixtures.
readonly GO_SOPS_IMAGE=golang:1.27.3-alpine
readonly LINT_IMAGE=golangci/golangci-lint:v2.15.0
readonly NFPM_IMAGE=goreleaser/nfpm:v2.48.0
readonly SHELLCHECK_IMAGE=koalaman/shellcheck:v0.11.0
readonly SHFMT_IMAGE=mvdan/shfmt:v3.14.1
# The yamllint image has only a major tag; the digest pins yamllint 1.32.0.
readonly YAMLLINT_IMAGE=cytopia/yamllint:1@sha256:596fb19eb71e55ba5b2fa56d8c18a615ec82adc8d3bf2d73918cb78c8f3240fb
readonly TOFU_IMAGE=ghcr.io/opentofu/opentofu:1.13.2
# The hosts run Debian 13: its nft, drbdadm and docker-compose check the
# renderers' output.
readonly DEBIAN_IMAGE=debian:trixie-slim
# Go's module and build cache survive between runs.
readonly CACHE_VOLUME=clowder-gocache
readonly BUSYBOX_IMAGE=busybox:1.37.0
# What the live tests keep between runs, so bin/dev live down finds it after
# a failure: the OpenTofu state, the SSH key, the cluster directory.
readonly LIVE_VOLUME=clowder-live
# The container that serves the clowderd package to the host.
readonly LIVE_PACKAGES=clowder-live-packages
# The private registry the test stack pulls from (test/live: registry).
readonly LIVE_REGISTRY=clowder-live-registry
readonly REGISTRY_IMAGE=registry:3.0.0
# HLab gives tools in the lab's network this address, and the hosts reach it.
readonly LAB_ADDRESS=192.0.2.2
readonly PACKAGE_PORT=8099
readonly REGISTRY_PORT=5000

# in_image <image> <command...>: Run a command in an image with the repository
# mounted at /src as the working directory.
in_image() {
  local image="$1"
  shift
  docker run --rm -v "${DOCKER_ROOT}:/src" -w /src -v "${CACHE_VOLUME}:/go" \
    -e GOFLAGS=-buildvcs=false "${image}" "$@"
}

# version: Print the version for the build without a leading v: a tag
# (v1.2.3 -> 1.2.3, v1.2.3-rc1 -> 1.2.3~rc1, which sorts before 1.2.3 in
# Debian's version order), otherwise 0.0.0~dev+<commit>, which sorts before
# any release.
version() {
  local tag commit
  if tag="$(cd "${ROOT}" && git describe --tags --exact-match 2>/dev/null)"; then
    tag="${tag#v}"
    echo "${tag//-/\~}"
    return
  fi
  commit="$(cd "${ROOT}" && git rev-parse --short HEAD 2>/dev/null || echo unknown)"
  echo "0.0.0~dev+${commit}"
}

# shell_files: Print the shell scripts of the repository.
shell_files() {
  (cd "${ROOT}" && git ls-files --cached --others --exclude-standard bin/dev '*.sh')
}

# cmd_lint: Run every style check; any finding fails.
cmd_lint() {
  local scripts
  in_image "${LINT_IMAGE}" golangci-lint run ./...
  mapfile -t scripts < <(shell_files)
  in_image "${SHELLCHECK_IMAGE}" "${scripts[@]}"
  in_image "${SHFMT_IMAGE}" -i 2 -ci -bn -d "${scripts[@]}"
  in_image "${YAMLLINT_IMAGE}" .
  in_image "${TOFU_IMAGE}" fmt -check -recursive .
  tofu_validate examples/hetzner
}

# tofu_validate <module>: Check an OpenTofu module against its providers,
# with the committed lock file only; the providers are cached in Go's cache
# volume, and OpenTofu's data stays out of the repository.
tofu_validate() {
  docker run --rm -v "${DOCKER_ROOT}:/src" -w "/src/$1" -v "${CACHE_VOLUME}:/go" \
    -e TF_PLUGIN_CACHE_DIR=/go/tofu-plugins -e TF_DATA_DIR=/tmp/tofu --entrypoint sh "${TOFU_IMAGE}" \
    -c 'mkdir -p "${TF_PLUGIN_CACHE_DIR}" && tofu init -backend=false -input=false -lockfile=readonly >/dev/null && tofu validate -no-color'
}

# cmd_format: Rewrite Go and shell files as the formatters want them.
cmd_format() {
  local scripts
  in_image "${LINT_IMAGE}" golangci-lint fmt ./...
  mapfile -t scripts < <(shell_files)
  in_image "${SHFMT_IMAGE}" -i 2 -ci -bn -w "${scripts[@]}"
}

# cmd_test: Run the unit tests; arguments go to go test, e.g.
# bin/dev test ./internal/compose -update
cmd_test() {
  if (($# == 0)); then
    set -- ./...
  fi
  local status=0
  # with the race detector: the agent's loops share the runner and the state
  in_image "${GO_IMAGE}" go test -race "$@" || status=$?
  if [[ " $* " == *" -update "* ]]; then
    give_back internal
  fi
  return "${status}"
}

# cmd_test_sops: Run the cross-tests of internal/sopsage against Alpine's sops.
cmd_test_sops() {
  in_image "${GO_SOPS_IMAGE}" sh -c \
    'apk add --no-cache sops >/dev/null && go test -tags sops ./internal/sopsage'
}

# cmd_test_tools: Check the renderers' golden files with Debian's nft,
# drbdadm and docker-compose (the hostname node0 is a host of the resource
# files).
cmd_test_tools() {
  docker run --rm --cap-add NET_ADMIN --hostname node0 -v "${DOCKER_ROOT}:/src" -w /src \
    "${DEBIAN_IMAGE}" sh test/tools/check-golden-files.sh
}

# cmd_build: Build clowderd for Linux and clowder for each platform into dist/.
cmd_build() {
  local ldflags target goos goarch
  ldflags="-s -w -X github.com/webcodingcat/clowder/internal/buildinfo.Version=$(version)"
  rm -rf "${ROOT}/dist"
  in_image "${GO_IMAGE}" env CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -trimpath -ldflags "${ldflags}" -o dist/linux-amd64/clowderd ./cmd/clowderd
  for target in linux/amd64 darwin/amd64 darwin/arm64 windows/amd64; do
    goos="${target%/*}"
    goarch="${target#*/}"
    in_image "${GO_IMAGE}" env CGO_ENABLED=0 GOOS="${goos}" GOARCH="${goarch}" \
      go build -trimpath -ldflags "${ldflags}" \
      -o "dist/${goos}-${goarch}/clowder$([[ "${goos}" == windows ]] && echo .exe)" \
      ./cmd/clowder
  done
  give_back dist
}

# give_back <path>: The containers run as root, so on Linux (CI as well) what
# they write belongs to root; hand it to the caller (dist/ after a build, the
# golden files after test -update).
give_back() {
  in_image "${GO_IMAGE}" chown -R "$(id -u):$(id -g)" "$1"
}

# cmd_package: Build, then make the Debian packages of both binaries.
cmd_package() {
  local package package_version
  cmd_build
  package_version="$(version)"
  for package in clowder clowderd; do
    # the image's entrypoint is nfpm itself
    docker run --rm -v "${DOCKER_ROOT}:/src" -w /src -e VERSION="${package_version}" \
      "${NFPM_IMAGE}" package --config "packaging/${package}.yaml" --packager deb \
      --target dist/
  done
  give_back dist
  ls -1 "${ROOT}/dist"/*.deb
}

# lab <arguments>: HLab's wrapper with the live tests' lab.
# Globals:
#   HLAB (read)
lab() {
  "${HLAB:?set HLAB to the path of bin/hlab in HLab}" -c "${ROOT}/test/live/lab.yaml" "$@"
}

# in_lab <image> <command...>: Run a command in the lab's network with the
# repository at /src as the working directory, Go's caches at /go and the
# live tests' files at /work.
# Globals:
#   HLAB_NETWORK, HCLOUD_ENDPOINT, HCLOUD_TOKEN (read)
in_lab() {
  local image="$1"
  shift
  docker run --rm -i --network "${HLAB_NETWORK}" -v "${DOCKER_ROOT}:/src" -w /src \
    -v "${CACHE_VOLUME}:/go" -v "${LIVE_VOLUME}:/work" -e HCLOUD_ENDPOINT -e HCLOUD_TOKEN \
    -e GOFLAGS=-buildvcs=false "${image}" "$@"
}

# live_tofu <command>: A shell command with OpenTofu on examples/hetzner in
# the lab's network; the state and OpenTofu's data stay in /work.
# Globals:
#   HLAB_NETWORK, HCLOUD_ENDPOINT, HCLOUD_TOKEN (read)
live_tofu() {
  docker run --rm --network "${HLAB_NETWORK}" -v "${DOCKER_ROOT}:/src" -w /src/examples/hetzner \
    -v "${CACHE_VOLUME}:/go" -v "${LIVE_VOLUME}:/work" -e HCLOUD_ENDPOINT -e HCLOUD_TOKEN \
    -e TF_DATA_DIR=/work/tofu -e TF_PLUGIN_CACHE_DIR=/go/tofu-plugins -e TF_IN_AUTOMATION=1 \
    --entrypoint sh "${TOFU_IMAGE}" -c "mkdir -p \"\${TF_PLUGIN_CACHE_DIR}\" \
      && tofu init -input=false -lockfile=readonly >/dev/null && $1"
}

# live_host_left: Tell whether an earlier run left OpenTofu state, that is a
# host. A failure to look is an error, not a "no": the state is the only way
# to destroy the host.
live_host_left() {
  local answer
  answer="$(in_lab "${GO_IMAGE}" sh -c 'if test -e /work/terraform.tfstate; then echo yes; else echo no; fi')"
  case "${answer}" in
    yes) return 0 ;;
    no) return 1 ;;
    *)
      echo "bin/dev live: cannot tell whether a host is left" >&2
      exit 1
      ;;
  esac
}

# start_registry: A private registry in the lab's network, with TLS from a
# throw-away CA and a password, as test/live expects them in
# /work/registry (ca.crt, password; the user is tester).
# Globals:
#   HLAB_NETWORK (read)
start_registry() {
  # Debian's openssl and htpasswd (bcrypt, which the registry wants), in the
  # Debian image the tools already use, rather than one more image; outside
  # the lab's network, where apt reaches Debian's mirror
  docker run --rm -v "${LIVE_VOLUME}:/work" -e "ADDRESS=${LAB_ADDRESS}" "${DEBIAN_IMAGE}" sh -c '
    set -e
    apt-get -qq update && apt-get -qq install -y --no-install-recommends openssl apache2-utils >/dev/null
    mkdir /work/registry && cd /work/registry
    openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:P-256 -nodes -days 2 \
      -subj /CN=clowder-live-ca -keyout ca.key -out ca.crt 2>/dev/null
    openssl req -newkey ec -pkeyopt ec_paramgen_curve:P-256 -nodes -subj "/CN=${ADDRESS}" \
      -keyout server.key -out server.csr 2>/dev/null
    printf "subjectAltName=IP:%s\n" "${ADDRESS}" >server.ext
    openssl x509 -req -in server.csr -CA ca.crt -CAkey ca.key -CAcreateserial -days 2 \
      -extfile server.ext -out server.crt 2>/dev/null
    openssl rand -hex 16 >password
    htpasswd -Bbn tester "$(cat password)" >htpasswd'
  docker rm -f "${LIVE_REGISTRY}" >/dev/null 2>&1 || true
  docker run -d --rm --name "${LIVE_REGISTRY}" --network "${HLAB_NETWORK}" \
    -v "${LIVE_VOLUME}:/work:ro" -e "REGISTRY_HTTP_ADDR=${LAB_ADDRESS}:${REGISTRY_PORT}" \
    -e REGISTRY_HTTP_TLS_CERTIFICATE=/work/registry/server.crt \
    -e REGISTRY_HTTP_TLS_KEY=/work/registry/server.key \
    -e REGISTRY_AUTH=htpasswd -e REGISTRY_AUTH_HTPASSWD_REALM=clowder-live \
    -e REGISTRY_AUTH_HTPASSWD_PATH=/work/registry/htpasswd "${REGISTRY_IMAGE}" >/dev/null
}

# cmd_live: Run the live tests on a new host; tear it down if they pass.
cmd_live() {
  local sha256 public_key status=0
  cmd_package
  lab up
  eval "$(lab env)"
  if live_host_left; then
    echo "bin/dev live: an earlier run left its host; bin/dev live down removes it" >&2
    return 1
  fi
  in_lab "${GO_IMAGE}" sh -c 'rm -rf /work/* && mkdir /work/www \
    && ssh-keygen -q -t ed25519 -N "" -C clowder-live -f /work/id_ed25519'
  sha256="$(in_lab "${GO_IMAGE}" sh -c 'cp dist/clowderd_*_amd64.deb /work/www/clowderd.deb \
    && sha256sum /work/www/clowderd.deb' | cut -d ' ' -f 1)"
  public_key="$(in_lab "${GO_IMAGE}" cat /work/id_ed25519.pub)"
  in_lab "${GO_IMAGE}" sh -c 'cat >/work/live.tfvars' <<EOF
ssh_public_key          = "${public_key}"
admin_cidrs             = ["${LAB_ADDRESS}/32"]
clowderd_package_url    = "http://${LAB_ADDRESS}:${PACKAGE_PORT}/clowderd.deb"
clowderd_package_sha256 = "${sha256}"
EOF
  docker rm -f "${LIVE_PACKAGES}" >/dev/null 2>&1 || true
  docker run -d --rm --name "${LIVE_PACKAGES}" --network "${HLAB_NETWORK}" \
    -v "${LIVE_VOLUME}:/work:ro" "${BUSYBOX_IMAGE}" \
    httpd -f -p "${LAB_ADDRESS}:${PACKAGE_PORT}" -h /work/www >/dev/null
  start_registry
  live_tofu 'tofu apply -input=false -auto-approve -state=/work/terraform.tfstate \
    -var-file=/work/live.tfvars && tofu output -json -state=/work/terraform.tfstate >/work/outputs.json' \
    && in_lab "${GO_IMAGE}" env LIVE_DIR=/work CLOWDER=/src/dist/linux-amd64/clowder \
      go test -tags live -count=1 -timeout 90m -v ./test/live \
    || status=$?
  docker rm -f "${LIVE_PACKAGES}" "${LIVE_REGISTRY}" >/dev/null
  if ((status != 0)); then
    echo "bin/dev live: failed; the host stays for a look (ssh from the lab's network with" \
      "/work/id_ed25519 in the volume ${LIVE_VOLUME}); bin/dev live down removes it" >&2
    return "${status}"
  fi
  cmd_live_down
}

# cmd_live_down: Destroy what the live tests left and stop their lab.
cmd_live_down() {
  lab up
  eval "$(lab env)"
  docker rm -f "${LIVE_PACKAGES}" "${LIVE_REGISTRY}" >/dev/null 2>&1 || true
  if live_host_left; then
    live_tofu 'tofu destroy -input=false -auto-approve -state=/work/terraform.tfstate \
      -var-file=/work/live.tfvars'
  fi
  # only after a destroy that worked (set -e): the state goes with the rest
  in_lab "${GO_IMAGE}" sh -c 'rm -rf /work/*'
  lab down
}

# cmd_all: Everything CI runs.
cmd_all() {
  cmd_lint
  cmd_test
  cmd_test_sops
  cmd_test_tools
  cmd_package
}

# main: Dispatch to the command named in the first argument.
main() {
  case "${1:-}" in
    lint | format | build | package | all) "cmd_$1" ;;
    test) cmd_test "${@:2}" ;;
    test-sops) cmd_test_sops ;;
    test-tools) cmd_test_tools ;;
    live)
      if [[ "${2:-}" == down ]]; then
        cmd_live_down
      else
        cmd_live
      fi
      ;;
    *)
      sed -n '2,/^set -euo/p' "${BASH_SOURCE[0]}" | sed '$d' | sed 's/^# \{0,1\}//' >&2
      exit 2
      ;;
  esac
}

main "$@"
