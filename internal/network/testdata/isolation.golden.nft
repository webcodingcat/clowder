table inet clowder
delete table inet clowder
table inet clowder {
  set cluster_hosts {
    type ipv4_addr
    elements = { 10.0.0.2, 10.0.0.3, 10.0.0.4, 203.0.113.20, 203.0.113.21, 203.0.113.22 }
  }
  chain marks {
    type filter hook prerouting priority mangle; policy accept;
    ct state new iifname "clw-1" ct mark set ct mark & 0xfffff000 | 0x101
    ct state new iifname "clw-2" ct mark set ct mark & 0xfffff000 | 0x102
    iifname { "cbr-*", "docker0", "br-*" } meta mark set ct mark & 0xfff
  }
  chain guard_in {
    type filter hook input priority filter; policy accept;
    iifname { "cbr-*", "docker0", "br-*" } fib saddr . iif oif missing counter drop
    iifname { "cbr-*", "docker0", "br-*" } ct state established,related accept
    iifname { "cbr-*", "docker0", "br-*" } ip daddr 169.254.77.53 meta l4proto { tcp, udp } th dport 53 accept
    iifname { "cbr-*", "docker0", "br-*" } ip daddr 203.0.113.11 tcp dport { 80, 443 } accept
    iifname { "cbr-*", "docker0", "br-*" } drop
  }
  chain guard_fwd {
    type filter hook forward priority filter - 10; policy accept;
    iifname { "cbr-*", "docker0", "br-*" } fib saddr . iif oif missing counter drop
    iifname { "cbr-*", "docker0", "br-*" } ct state established,related accept
    iifname { "cbr-*", "docker0", "br-*" } ct status dnat accept
    iifname { "cbr-*", "docker0", "br-*" } ip daddr 169.254.169.254 counter drop
    iifname { "cbr-*", "docker0", "br-*" } ip daddr @cluster_hosts counter drop
    iifname { "cbr-*", "docker0", "br-*" } ip daddr 10.0.0.0/16 counter drop
    iifname { "cbr-*", "docker0", "br-*" } ip daddr 10.77.0.0/24 counter drop
  }
  chain guard_out {
    type filter hook output priority filter; policy accept;
    ip daddr 169.254.169.254 counter drop
  }
  chain forwards {
    type nat hook prerouting priority dstnat - 10; policy accept;
    ip daddr 203.0.113.11 tcp dport 9988 ct mark set ct mark & 0xfffff000 | 0x200 dnat ip to 10.77.0.3:9988
    ip daddr 203.0.113.11 udp dport 9987 ct mark set ct mark & 0xfffff000 | 0x200 dnat ip to 10.77.0.3:9987
  }
  chain hairpin {
    type nat hook postrouting priority srcnat - 10; policy accept;
    iifname { "cbr-*", "docker0", "br-*" } ct mark & 0xfff == 0x200 snat ip to 10.77.0.1
  }
  chain mss {
    type filter hook forward priority mangle; policy accept;
    oifname "clw-*" tcp flags syn / syn,rst tcp option maxseg size set rt mtu
  }
}
